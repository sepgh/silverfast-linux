#!/usr/bin/env bash
# silverfast-linux: install and run SilverFast 9 for Windows under Wine, with
# USB scanner access through silverfast-usbd. See README.md and
# docs/how-it-works.md.
set -euo pipefail

VERSION=0.2.0

# --- locations -------------------------------------------------------------
DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
SFL_HOME=${SFL_HOME:-$DATA_HOME/silverfast-linux}
CACHE_DIR=${SFL_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/silverfast-linux}
export WINEPREFIX=${SFL_PREFIX:-$SFL_HOME/prefix}
export WINEARCH=win64
FIRMWARE_DIR=$SFL_HOME/firmware
LOG_DIR=$SFL_HOME/logs
RUN_DIR=${XDG_RUNTIME_DIR:-/tmp/silverfast-linux-$UID}/silverfast-linux
SOCKET=$RUN_DIR/usbd.sock         # used by Wine Staging (AF_UNIX)
PORT_FILE=$RUN_DIR/usbd.port      # loopback TCP fallback for mainline Wine
TOKEN_FILE=$RUN_DIR/usbd.token    # session secret; RUN_DIR is mode 0700
DESKTOP_FILE=$DATA_HOME/applications/silverfast-linux.desktop
INSTALLED=$SFL_HOME/scanners.txt  # "<registry slot> <model id>" per installed scanner

APP_DIR_WIN='C:\Program Files\SilverFast Application\SilverFast 9'
APP_DIR=$WINEPREFIX/drive_c/Program\ Files/SilverFast\ Application/SilverFast\ 9
PROGRAMDATA_DIR=$WINEPREFIX/drive_c/ProgramData/LaserSoft\ Imaging/SilverFast\ 9
ICC_DIR=$WINEPREFIX/drive_c/windows/system32/spool/drivers/color
SYSTEM32=$WINEPREFIX/drive_c/windows/system32

# Our own build outputs: next to an installed script, or in a source checkout.
SCRIPT_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ -f "$SCRIPT_DIR/../lib/silverfast-linux/sti.dll" ]; then
    LIB_DIR=$(cd "$SCRIPT_DIR/../lib/silverfast-linux" && pwd)
    STI_DLL=$LIB_DIR/sti.dll USBD=$LIB_DIR/silverfast-usbd
    COMPONENTS=$LIB_DIR/components.txt MODELS_DIR=$LIB_DIR/models
    REPORT_PY=$LIB_DIR/sfl-report.py MODELS_PY=$LIB_DIR/sfl-models.py
else
    ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
    STI_DLL=$ROOT/build/sti.dll USBD=$ROOT/build/silverfast-usbd
    COMPONENTS=$ROOT/scripts/components.txt MODELS_DIR=$ROOT/models
    REPORT_PY=$ROOT/scripts/sfl-report.py MODELS_PY=$ROOT/scripts/sfl-models.py
fi

# --- vendor sources --------------------------------------------------------
# SilverFast 9 is published as a Qt Installer Framework repository. The
# release index points at the current versioned repository; every archive
# has a .sha1 next to it. Only the Windows build is used.
SF_RELEASE_INDEX=https://cdn9.silverfast.com/release/sf9/win/Updates.xml
# Scanner drivers come from the catalog in models/ (see models/README.md).

SF_VERSION=

# --- output helpers --------------------------------------------------------
if [ -t 1 ]; then B=$'\e[1m' G=$'\e[32m' Y=$'\e[33m' R=$'\e[31m' N=$'\e[0m'; else B='' G='' Y='' R='' N=''; fi
step() { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

models() { python3 "$MODELS_PY" --models "$MODELS_DIR" "$@"; }
field() { models field "$1" "$2"; }

quiet_wine() { WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml=;winemenubuilder.exe=d;${WINEDLLOVERRIDES:-}" "$@"; }

usage() {
    cat <<EOF
silverfast-linux $VERSION - SilverFast 9 on Linux through Wine

usage: silverfast-linux <command> [options]

commands:
  install --accept-vendor-licenses [--scanner ID ...]
                 download SilverFast 9 and the scanner drivers from their
                 vendors and set up a dedicated Wine prefix (default scanners:
                 every supported one plus any connected catalog scanner)
  run [--scanner ID] [-- SILVERFAST ARGS]
                 start the USB helper for the connected scanner, and SilverFast
  scanners       list the scanner catalog and which scanners are connected
  drivers [--device VID:PID] [--download UPDATE_ID]
                 show where to get a scanner's Windows driver: the catalog and
                 Microsoft's Update Catalog; --download fetches an update
  doctor         check that everything needed for scanning is in place
  udev           print the commands that grant USB access to catalog scanners
  try-scanner --driver FILE|URL [--device VID:PID]
                 experimental: register an unsupported scanner from its Windows
                 driver, run SilverFast with full logging, and write a report
  report [--device VID:PID] [--driver FILE|URL] [--output FILE]
                 collect what is needed to support a new scanner, as Markdown
                 to attach to a GitHub issue (see docs/adding-a-scanner.md)
  uninstall [--purge]
                 remove the Wine prefix (--purge also drops the download cache)
  version        print the version

environment:
  SFL_HOME       data directory (default: $DATA_HOME/silverfast-linux)
  SFL_VERBOSE=1  log every USB transfer to $LOG_DIR/usbd.log
EOF
}

need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed${2:+ ($2)}"; }

check_tools() {
    need wine "install Wine 9 or newer"
    need wineserver
    need curl
    need 7z "install p7zip / 7zip"
    need python3
    need sha1sum
    need sha256sum
    [ -f "$STI_DLL" ] && [ -x "$USBD" ] || die "build outputs missing ($STI_DLL, $USBD); run 'make' or 'make container' first"
    local v; v=$(wine --version 2>/dev/null | sed -n 's/^wine-\([0-9]*\).*/\1/p')
    [ -n "$v" ] && [ "$v" -ge 9 ] || die "Wine 9 or newer is required (found: $(wine --version 2>/dev/null))"
}

# download URL DEST [SHA1|-] [SHA256|-]
download() {
    local url=$1 dest=$2 sha1=${3:--} sha256=${4:--}
    if [ -f "$dest" ] && verify "$dest" "$sha1" "$sha256" 2>/dev/null; then return 0; fi
    mkdir -p "$(dirname "$dest")"
    local progress=-sS
    [ -t 1 ] && progress=--progress-bar
    curl -fL --retry 3 "$progress" -o "$dest.part" "$url" || die "download failed: $url"
    mv "$dest.part" "$dest"
    verify "$dest" "$sha1" "$sha256" || { rm -f "$dest"; die "checksum mismatch for $url"; }
}

verify() {
    local f=$1 sha1=$2 sha256=$3
    if [ "$sha1" != - ]; then [ "$(sha1sum "$f" | cut -d' ' -f1)" = "$sha1" ] || return 1; fi
    if [ "$sha256" != - ]; then [ "$(sha256sum "$f" | cut -d' ' -f1)" = "$sha256" ] || return 1; fi
    return 0
}

# --- install ---------------------------------------------------------------
create_prefix() {
    step "Creating Wine prefix in $WINEPREFIX"
    if [ -f "$WINEPREFIX/system.reg" ]; then ok "prefix exists"; return; fi
    mkdir -p "$WINEPREFIX"
    quiet_wine wineboot -i >/dev/null 2>&1 || die "wineboot failed"
    quiet_wine wineserver -w
    ok "prefix created"
}

# Prints "<component> <version> <archive> <sha1-url-base>" for every wanted archive.
resolve_silverfast() {
    local index repo
    index=$(curl -fsSL "$SF_RELEASE_INDEX") || die "cannot reach LaserSoft's download server"
    repo=$(printf '%s' "$index" | python3 -c '
import sys, xml.etree.ElementTree as E
for r in E.fromstring(sys.stdin.read()).iter("Repository"):
    print(r.get("url")); break')
    [ -n "$repo" ] || die "unexpected SilverFast release index format"
    repo=${repo/https:\/\/cdn.silverfast.com\/9\//https://cdn9.silverfast.com/}
    curl -fsSL "$repo/Updates.xml" | python3 -c '
import sys, xml.etree.ElementTree as E
wanted = {}
for line in open(sys.argv[1]):
    line = line.split("#")[0].split()
    if line: wanted[line[0]] = line[1]
repo = sys.argv[2]
for p in E.fromstring(sys.stdin.read()).iter("PackageUpdate"):
    name, ver = p.findtext("Name").strip(), p.findtext("Version").strip()
    if name not in wanted: continue
    for a in (p.findtext("DownloadableArchives") or "").split(","):
        if a.strip(): print(name, wanted[name], f"{repo}/{name}/{ver}{a.strip()}")
' "$COMPONENTS" "$repo"
}

dest_dir() {
    case $1 in
        app) printf '%s' "$APP_DIR" ;;
        icc) printf '%s' "$ICC_DIR" ;;
        programdata/*) printf '%s/%s' "$PROGRAMDATA_DIR" "${1#programdata/}" ;;
        *) die "unknown destination '$1' in $COMPONENTS" ;;
    esac
}

install_silverfast() {
    step "Downloading SilverFast 9 from LaserSoft"
    local list name dest url file sha1 n=0
    list=$(resolve_silverfast)
    [ -n "$list" ] || die "no SilverFast components found"
    SF_VERSION=$(printf '%s\n' "$list" | head -1 | sed -n 's|.*/version/\([^/]*\)/.*|\1|p')
    ok "release ${SF_VERSION:-unknown}"
    while read -r name dest url; do
        file=$CACHE_DIR/silverfast/$name/$(basename "$url")
        sha1=$(curl -fsSL "$url.sha1" | cut -c1-40) || die "missing checksum for $url"
        download "$url" "$file" "$sha1"
        mkdir -p "$(dest_dir "$dest")"
        7z x -y -bso0 -bsp0 -o"$(dest_dir "$dest")" "$file" || die "cannot extract $file"
        n=$((n + 1))
    done <<< "$list"
    mkdir -p "$PROGRAMDATA_DIR/Drivers" "$PROGRAMDATA_DIR/AIModels"
    ok "$n archives verified and extracted"

    step "Installing the Visual C++ runtime bundled with SilverFast"
    quiet_wine wine "$APP_DIR/vc_redist.x64.exe" /quiet /norestart >/dev/null 2>&1 || true
    quiet_wine wineserver -w
    [ -f "$SYSTEM32/msvcp140.dll" ] && ok "runtime installed" || warn "VC++ runtime may be missing"
}

# Prints "<slot> <id>" for each installed scanner.
installed_scanners() { [ -f "$INSTALLED" ] && cat "$INSTALLED"; return 0; }

# install_scanner ID SLOT: driver files from the vendor, registry entry.
install_scanner() {
    local id=$1 slot=$2 url pkg tmp reg interp fw
    url=$(field "$id" driver.url)
    interp=$(field "$id" interpreter)
    fw=$(field "$id" firmware.file)
    if [ -n "$url" ]; then
        pkg=$CACHE_DIR/drivers/$(basename "${url%%\?*}")
        download "$url" "$pkg" - "$(field "$id" driver.sha256)"
        tmp=$(mktemp -d)
        models extract "$id" "$pkg" "$tmp" >/dev/null || { rm -rf "$tmp"; die "cannot take the needed files from $(basename "$pkg")"; }
        [ -z "$interp" ] || install -Dm644 "$tmp/$interp" "$SYSTEM32/$interp"
        [ -z "$fw" ] || install -Dm644 "$tmp/$fw" "$FIRMWARE_DIR/$fw"
        rm -rf "$tmp"
    fi
    reg=$(mktemp --suffix=.reg)
    models registry "$id" "$slot" > "$reg"
    quiet_wine wine regedit /S "$(quiet_wine winepath -w "$reg")" || die "registry import failed"
    rm -f "$reg"
    ok "$(field "$id" name)${interp:+, interpreter $interp}${fw:+, firmware $fw}"
}

install_scanners() {
    local ids=("$@") reg i=0 slot
    step "Installing scanner support"
    [ ${#ids[@]} -gt 0 ] || { warn "no scanners selected"; return; }
    # Drop earlier registrations so removed scanners disappear from SilverFast.
    reg=$(mktemp --suffix=.reg)
    { echo REGEDIT4; echo; for slot in $(seq -f %04g 0 31); do
        echo "[-HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Class\\{6BDD1FC6-810F-11D0-BEC7-08002BE2092F}\\$slot]"
      done; } > "$reg"
    quiet_wine wine regedit /S "$(quiet_wine winepath -w "$reg")" || true
    rm -f "$reg"
    : > "$INSTALLED"
    for id in "${ids[@]}"; do
        slot=$(printf %04d "$i")
        install_scanner "$id" "$slot"
        echo "$slot $id" >> "$INSTALLED"
        i=$((i + 1))
    done
    quiet_wine wineserver -w
}

install_bridge() {
    step "Installing the sti.dll replacement"
    install -Dm644 "$STI_DLL" "$SYSTEM32/sti.dll"
    local reg; reg=$(mktemp --suffix=.reg)
    cat > "$reg" <<EOF
REGEDIT4

[HKEY_CURRENT_USER\\Software\\Wine\\DllOverrides]
"sti"="native"

[HKEY_LOCAL_MACHINE\\SOFTWARE\\LaserSoft Imaging\\SilverFast 9]
"x64_path"="${APP_DIR_WIN//\\/\\\\}"
"x64_Version"="${SF_VERSION:-9}"
"x64_Stamp"="$(date +%s)000"
EOF
    quiet_wine wine regedit /S "$(quiet_wine winepath -w "$reg")" || die "registry import failed"
    quiet_wine wineserver -w
    rm -f "$reg"
    ok "sti.dll installed"
}

install_desktop_entry() {
    step "Adding a desktop entry"
    mkdir -p "$(dirname "$DESKTOP_FILE")"
    cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=SilverFast 9
Comment=Scan with SilverFast 9 (via Wine)
Exec=$(readlink -f "$0") run
Icon=scanner
Categories=Graphics;Scanning;
Terminal=false
EOF
    ok "$DESKTOP_FILE"
}

cmd_install() {
    local accepted=0 scanners=() ids
    while [ $# -gt 0 ]; do
        case $1 in
            --accept-vendor-licenses) accepted=1; shift ;;
            --scanner) scanners+=("${2:?}"); shift 2 ;;
            *) die "unknown install option: $1" ;;
        esac
    done
    if [ $accepted = 0 ]; then
        cat <<EOF
silverfast-linux downloads proprietary software directly from its vendors:
  - SilverFast 9 by LaserSoft Imaging AG          https://www.silverfast.com
  - your scanner's Windows driver from its maker  (see 'silverfast-linux scanners')
Using them means accepting their licence terms. Nothing from any vendor is
redistributed by this project. SilverFast itself still needs your own
MySilverFast licence to scan.

Re-run with --accept-vendor-licenses to continue.
EOF
        exit 1
    fi
    check_tools
    mapfile -t ids < <(models select "${scanners[@]}") || die "unknown scanner"
    mkdir -p "$SFL_HOME" "$CACHE_DIR" "$LOG_DIR"
    create_prefix
    install_silverfast
    install_bridge
    install_scanners "${ids[@]}"
    install_desktop_entry
    step "Done"
    for id in "${ids[@]}"; do
        usb_access_ok "$(field "$id" usb)" || warn "$(field "$id" name) is not accessible yet; run 'silverfast-linux udev' for the fix"
    done
    echo "Start SilverFast with: silverfast-linux run"
}

# --- run -------------------------------------------------------------------
# scanner_node VID:PID: prints the /dev/bus/usb node of the device, if connected.
scanner_node() {
    local d
    for d in /sys/bus/usb/devices/*; do
        [ -f "$d/idVendor" ] || continue
        [ "$(cat "$d/idVendor"):$(cat "$d/idProduct")" = "$1" ] || continue
        printf '/dev/bus/usb/%03d/%03d\n' "$(cat "$d/busnum")" "$(cat "$d/devnum")"
        return 0
    done
    return 1
}

usb_access_ok() {
    local node; node=$(scanner_node "$1") || return 0  # not connected: nothing to check
    [ -r "$node" ] && [ -w "$node" ]
}

helper_running() {
    python3 - "$SOCKET" <<'EOF' 2>/dev/null
import socket, sys
s = socket.socket(socket.AF_UNIX)
s.settimeout(1)
s.connect(sys.argv[1])
EOF
}

# start_helper LOGDIR [helper args...]: starts silverfast-usbd unless one is
# already serving, and exports what sti.dll needs to reach it.
start_helper() {
    local logdir=$1; shift
    mkdir -p "$logdir" "$RUN_DIR"
    chmod 700 "$RUN_DIR"
    HELPER_PID=
    if helper_running && [ -s "$TOKEN_FILE" ] && [ -s "$PORT_FILE" ]; then
        [ $# -eq 0 ] || die "silverfast-usbd is already running for another session; close SilverFast first"
        ok "silverfast-usbd already running"
    else
        rm -f "$PORT_FILE"
        (umask 077; od -An -N16 -tx1 /dev/urandom | tr -d ' \n' > "$TOKEN_FILE")
        SFL_USBD_TOKEN=$(cat "$TOKEN_FILE") "$USBD" --socket "$SOCKET" --tcp-port-file "$PORT_FILE" \
            --log "$logdir/usbd.log" ${SFL_VERBOSE:+--verbose} "$@" &
        HELPER_PID=$!
        trap '[ -n "$HELPER_PID" ] && kill "$HELPER_PID" 2>/dev/null; wait 2>/dev/null; rm -f "$TOKEN_FILE"' EXIT
        for _ in $(seq 100); do [ -S "$SOCKET" ] && [ -s "$PORT_FILE" ] && break; sleep 0.1; done
        [ -S "$SOCKET" ] && [ -s "$PORT_FILE" ] || die "silverfast-usbd did not start; see $logdir/usbd.log"
    fi
    export SFL_USBD_SOCKET=$SOCKET SFL_USBD_TCP SFL_USBD_TOKEN SFL_STI_LOG
    SFL_USBD_TCP=$(cat "$PORT_FILE")
    SFL_USBD_TOKEN=$(cat "$TOKEN_FILE")
    SFL_STI_LOG=$(WINEDEBUG=-all winepath -w "$logdir/sti.log" 2>/dev/null)
}

# launch_silverfast LOGDIR [args...]: runs SilverFast and waits for Wine to exit.
launch_silverfast() {
    local logdir=$1; shift
    export WINEDLLOVERRIDES="sti=n;winemenubuilder.exe=d;${WINEDLLOVERRIDES:-}"
    export WINEDEBUG=${WINEDEBUG:--all}
    (cd "$APP_DIR" && wine "SilverFast 9.exe" "$@" >>"$logdir/wine.log" 2>&1) || true
    wineserver -w
}

# helper_args_for ID: silverfast-usbd options for an installed catalog scanner.
helper_args_for() {
    local fw; fw=$(field "$1" firmware.file)
    printf '%s\n' --device "$(field "$1" usb)" --name "$(field "$1" name)"
    [ -z "$fw" ] || printf '%s\n' --firmware "$fw" --firmware-dir "$FIRMWARE_DIR"
}

cmd_run() {
    local wanted='' id='' slot sid usb args=()
    if [ "${1:-}" = --scanner ]; then wanted=${2:?}; shift 2; fi
    [ "${1:-}" = -- ] && shift
    [ -f "$APP_DIR/SilverFast 9.exe" ] || die "SilverFast is not installed; run 'silverfast-linux install' first"
    [ -s "$INSTALLED" ] || die "no scanner installed; run 'silverfast-linux install' again"
    # Use the requested scanner, else the first installed one that is connected.
    while read -r slot sid; do
        if [ -n "$wanted" ]; then
            [ "$sid" = "$wanted" ] || [ "$(field "$sid" usb)" = "$wanted" ] && { id=$sid; break; }
        elif scanner_node "$(field "$sid" usb)" >/dev/null; then id=$sid; break
        fi
        [ -n "$id" ] || id=$sid
    done < "$INSTALLED"
    [ -n "$id" ] || die "scanner '$wanted' is not installed"
    usb=$(field "$id" usb)
    if ! scanner_node "$usb" >/dev/null; then warn "$(field "$id" name) is not connected; SilverFast will start without it"
    elif ! usb_access_ok "$usb"; then warn "no permission to use the scanner; run 'silverfast-linux udev' for the fix"; fi
    mapfile -t args < <(helper_args_for "$id")
    start_helper "$LOG_DIR" "${args[@]}"
    launch_silverfast "$LOG_DIR" "$@"
}

cmd_scanners() {
    models list
    echo
    echo "Installed: $(installed_scanners | awk '{print $2}' | paste -sd' ' -)"
    echo "Not listed? See https://github.com/sepgh/silverfast-linux/blob/main/docs/adding-a-scanner.md"
}

cmd_drivers() {
    local device='' download_id='' url file
    while [ $# -gt 0 ]; do
        case $1 in
            --device) device=${2:?}; shift 2 ;;
            --download) download_id=${2:?}; shift 2 ;;
            *) die "unknown drivers option: $1" ;;
        esac
    done
    if [ -n "$download_id" ]; then
        step "Downloading Microsoft Update Catalog entry $download_id"
        while read -r url; do
            file=$CACHE_DIR/drivers/$(basename "${url%%\?*}")
            download "$url" "$file"
            ok "$file"
            echo "  Try it: silverfast-linux try-scanner --driver '$file'"
        done < <(models ms-download "$download_id")
        return
    fi
    if [ -z "$device" ]; then
        device=$(models list --json | python3 -c 'import json,sys; print("\n".join(m["usb"] for m in json.load(sys.stdin) if m["connected"]))')
        [ -n "$device" ] || device=$(python3 "$REPORT_PY" --list-candidates)
        [ -n "$device" ] || die "no scanner-like USB device found; connect it or pass --device VID:PID"
    fi
    for usb in $device; do models drivers "$usb"; echo; done
    echo "Fetch a Microsoft Update Catalog entry with: silverfast-linux drivers --download UPDATE_ID"
}

# --- try-scanner -------------------------------------------------------------
# Registry slot for the scanner being tried; the supported V600 uses 0000.
TRY_SLOT=0100

try_cleanup() {
    local reg; reg=$(mktemp --suffix=.reg)
    printf 'REGEDIT4\n\n[-HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\Class\\{6BDD1FC6-810F-11D0-BEC7-08002BE2092F}\\%s]\n' "$TRY_SLOT" > "$reg"
    quiet_wine wine regedit /S "$(quiet_wine winepath -w "$reg")" 2>/dev/null || true
    rm -f "$reg"
}

cmd_try_scanner() {
    local device='' driver='' url='' report dir model usb interp fw args=()
    while [ $# -gt 0 ]; do
        case $1 in
            --device) device=${2:?}; shift 2 ;;
            --driver) driver=${2:?}; shift 2 ;;
            *) die "unknown try-scanner option: $1" ;;
        esac
    done
    [ -n "$driver" ] || die "try-scanner needs --driver FILE|URL (the scanner's Windows driver package)"
    [ -f "$APP_DIR/SilverFast 9.exe" ] || die "SilverFast is not installed; run 'silverfast-linux install' first"
    ! helper_running || die "SilverFast is already running; close it first"
    need python3; need 7z
    if [[ $driver == http://* || $driver == https://* ]]; then
        step "Downloading the driver package"
        url=$driver
        driver=$CACHE_DIR/drivers/$(basename "${driver%%\?*}")
        download "$url" "$driver"
    fi

    report=$PWD/silverfast-linux-try-$(date +%Y%m%d-%H%M%S).md
    dir=$SFL_HOME/try/$(date +%Y%m%d-%H%M%S)
    model=$dir/model.json
    mkdir -p "$dir/logs"
    step "Reading the scanner and its Windows driver"
    python3 "$REPORT_PY" --tool-version "$VERSION" ${device:+--device "$device"} --driver "$driver" \
        ${url:+--driver-url "$url"} --model-json "$model" --keep-files "$dir/files" >"$report"
    [ -n "$(field "$model" usb 2>/dev/null)" ] || die "the driver package does not describe this scanner; see $report"
    usb=$(field "$model" usb)
    interp=$(field "$model" interpreter)
    fw=$(field "$model" firmware.file)
    ok "$(field "$model" name) ($usb)"

    step "Registering it in the Wine prefix (temporarily)"
    local reg; reg=$(mktemp --suffix=.reg)
    models registry "$model" "$TRY_SLOT" > "$reg"
    quiet_wine wine regedit /S "$(quiet_wine winepath -w "$reg")" || die "registry import failed"
    rm -f "$reg"
    [ -z "$interp" ] || install -Dm644 "$dir/files/$interp" "$SYSTEM32/$interp"
    trap 'try_cleanup' RETURN

    args=(--device "$usb" --name "$(field "$model" name)")
    # firmware is only set in the draft for Epson scanners (the implemented protocol)
    [ -z "$fw" ] || args+=(--firmware "$fw" --firmware-dir "$dir/files")
    step "Starting SilverFast with full USB logging"
    echo "  Select the scanner, press START, try a prescan, then close SilverFast."
    SFL_VERBOSE=1 start_helper "$dir/logs" "${args[@]}"
    launch_silverfast "$dir/logs"

    step "Adding the session logs to the report"
    python3 - "$report" "$dir/logs" "$WINEPREFIX" <<'PY'
import glob, os, re, sys
report, logs, prefix = sys.argv[1:4]
home = os.path.expanduser("~")
def clean(t):
    t = t.replace(home, "~")
    t = re.sub(r"(?i)users[/\\][^/\\]+[/\\]", "users/<user>/", t)
    return re.sub(r"[\w.+-]+@[\w-]+\.[\w.-]+", "<email>", t)
def block(title, path, head=400, tail=300):
    try:
        lines = open(path, errors="replace").read().splitlines()
    except OSError:
        return f"### {title}\n\n(not found)\n"
    if len(lines) > head + tail:
        lines = lines[:head] + [f"... {len(lines) - head - tail} lines omitted ..."] + lines[-tail:]
    return f"### {title}\n\n```\n" + clean("\n".join(lines)) + "\n```\n"
sf_log = glob.glob(os.path.join(prefix, "drive_c/users/*/AppData/Roaming/LaserSoft Imaging/SilverFast 9/LogFile.txt"))
with open(report, "a") as f:
    f.write("\n## Try session\n\n")
    f.write(block("silverfast-usbd (USB traffic)", os.path.join(logs, "usbd.log")))
    f.write(block("sti.dll", os.path.join(logs, "sti.log")))
    f.write(block("SilverFast LogFile.txt (last lines)", sf_log[0], head=0, tail=200) if sf_log else "")
PY
    ok "report: $report"
    echo "Review it, then open a \"New scanner\" issue and attach it:"
    echo "  https://github.com/sepgh/silverfast-linux/issues/new?template=new-scanner.yml"
}

# --- doctor ----------------------------------------------------------------
cmd_doctor() {
    local fails=0
    check() { if eval "$2"; then ok "$1"; else warn "$1 — $3"; fails=$((fails + 1)); fi; }
    step "silverfast-linux $VERSION doctor"
    check "wine available ($(wine --version 2>/dev/null || echo none))" 'command -v wine >/dev/null' "install Wine 9+"
    check "helper binary" '[ -x "$USBD" ]' "run make"
    check "sti.dll build" '[ -f "$STI_DLL" ]' "run make"
    check "Wine prefix" '[ -f "$WINEPREFIX/system.reg" ]' "run silverfast-linux install"
    check "SilverFast installed" '[ -f "$APP_DIR/SilverFast 9.exe" ]' "run silverfast-linux install"
    check "SilverFast data folders" '[ -d "$PROGRAMDATA_DIR/Prefs" ] && [ -d "$PROGRAMDATA_DIR/NegaFix" ]' "re-run install"
    check "sti.dll installed in prefix" 'cmp -s "$STI_DLL" "$SYSTEM32/sti.dll"' "re-run install"
    check "scanner catalog ($(models list --json 2>/dev/null | grep -c '"id"') models)" 'models validate >/dev/null' "run: $MODELS_PY validate"
    check "scanners installed" '[ -s "$INSTALLED" ]' "re-run install"
    local slot id name usb interp fw any_connected=0
    while read -r slot id; do
        name=$(field "$id" name) usb=$(field "$id" usb) interp=$(field "$id" interpreter) fw=$(field "$id" firmware.file)
        [ -z "$interp" ] || check "$name: interpreter $interp" '[ -f "$SYSTEM32/$interp" ]' "re-run install"
        [ -z "$fw" ] || check "$name: firmware $fw" '[ -f "$FIRMWARE_DIR/$fw" ]' "re-run install"
        if scanner_node "$usb" >/dev/null; then
            # shellcheck disable=SC2034  # read by the eval in check() below
            any_connected=1
            ok "$name: connected"
            check "$name: accessible" 'usb_access_ok "$usb"' "run 'silverfast-linux udev'"
        fi
    done < <(installed_scanners)
    check "an installed scanner is connected" '[ $any_connected = 1 ]' "plug in and switch on your scanner"
    check "helper socket directory" '[ -n "${XDG_RUNTIME_DIR:-}" ]' "XDG_RUNTIME_DIR unset; using /tmp"
    [ $fails = 0 ] && step "All good" || { step "$fails problem(s) found"; return 1; }
}

cmd_udev() {
    local rules=$SFL_HOME/70-silverfast-linux.rules
    mkdir -p "$SFL_HOME"
    models udev > "$rules"
    cat <<EOF
Run these commands once to let your user open the catalog's scanners over USB
(rules: $rules):

  sudo install -m644 "$rules" /etc/udev/rules.d/70-silverfast-linux.rules
  sudo udevadm control --reload && sudo udevadm trigger

Then unplug and replug the scanner (or switch it off and on).
EOF
}

cmd_report() {
    local device='' driver='' output doctor_out file
    output=silverfast-linux-report-$(date +%Y%m%d-%H%M%S).md
    while [ $# -gt 0 ]; do
        case $1 in
            --device) device=${2:?}; shift 2 ;;
            --driver) driver=${2:?}; shift 2 ;;
            --output) output=${2:?}; shift 2 ;;
            *) die "unknown report option: $1" ;;
        esac
    done
    need python3
    [ -z "$driver" ] || need 7z "needed to unpack the driver package"
    if [[ $driver == http://* || $driver == https://* ]]; then
        step "Downloading the driver package"
        file=$CACHE_DIR/drivers/$(basename "${driver%%\?*}")
        download "$driver" "$file"
        driver=$file
    fi
    doctor_out=$(mktemp)
    cmd_doctor >"$doctor_out" 2>&1 || true
    step "Collecting scanner information"
    python3 "$REPORT_PY" --tool-version "$VERSION" --doctor "$doctor_out" \
        ${device:+--device "$device"} ${driver:+--driver "$driver"} >"$output"
    rm -f "$doctor_out"
    ok "written to $output"
    echo "Review the file (it contains no serial numbers or personal paths), then open"
    echo "a \"New scanner\" issue and attach it:"
    echo "  https://github.com/sepgh/silverfast-linux/issues/new?template=new-scanner.yml"
}

cmd_uninstall() {
    step "Removing $SFL_HOME"
    WINEDEBUG=-all wineserver -k 2>/dev/null || true
    rm -rf "$SFL_HOME" "$DESKTOP_FILE"
    if [ "${1:-}" = --purge ]; then rm -rf "$CACHE_DIR"; ok "download cache removed"; fi
    ok "removed"
}

case ${1:-} in
    install)   shift; cmd_install "$@" ;;
    run)       shift; cmd_run "$@" ;;
    doctor)    cmd_doctor ;;
    udev)      cmd_udev ;;
    scanners)  cmd_scanners ;;
    drivers)   shift; cmd_drivers "$@" ;;
    report)    shift; cmd_report "$@" ;;
    try-scanner) shift; cmd_try_scanner "$@" ;;
    uninstall) shift; cmd_uninstall "$@" ;;
    version)   echo "$VERSION" ;;
    -h|--help|help|"") usage ;;
    *) usage; exit 1 ;;
esac
